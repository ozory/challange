# ---- StackSpot AI (provedor de LLM) ----
STACKSPOT_REALM=
STACKSPOT_CLIENT_ID=
STACKSPOT_CLIENT_SECRET=
# Informe o ID do agente (a URL padrão de inferência é montada automaticamente)...
STACKSPOT_AGENT_ID=
# ...ou a URL completa, que tem precedência sobre STACKSPOT_AGENT_ID.
STACKSPOT_AGENT_URL=

# Opcional: reutilizar configuração local já existente sem copiar segredos.
# STACKSPOT_ENV_FILE=../../finguard-nivel1/.env

# Opcional: CA corporativa para o HTTPS da StackSpot.
# LLM_CA_BUNDLE=/caminho/para/ca.pem

# Opcional: destino dos logs (padrão: ao lado do backend).
# APP_LOG_FILE=backend.log
# AUDIT_LOG_FILE=security_audit.log
